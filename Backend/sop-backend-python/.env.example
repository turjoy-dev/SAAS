# ─────────────────────────────────────────────────────────────
# VisaWrite backend — environment template
# Copy to `.env` and fill in real values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────

# Supabase (Postgres). Use the SERVICE ROLE key server-side only —
# it bypasses RLS, so this backend must enforce ownership checks itself.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Groq — primary LLM (drafting + light evaluation)
GROQ_API_KEY=
GROQ_GENERATOR_MODEL=llama-3.3-70b-versatile
GROQ_CHECKER_MODEL=llama-3.1-8b-instant

# Gemini — critic + fallback drafter
GEMINI_API_KEY=
GEMINI_SCORING_MODEL=gemini-flash-latest
GEMINI_DRAFT_MODEL=gemini-flash-latest

# Manifest-driven knowledge root (absolute path to knowledge/manifests)
MANIFEST_ROOT=

# Optional: Bugsink / Sentry error tracking
BUGSINK_DSN=

# Set to "true" to run the LLM pipeline against canned strings (no API spend)
USE_MOCK_LLM=false
